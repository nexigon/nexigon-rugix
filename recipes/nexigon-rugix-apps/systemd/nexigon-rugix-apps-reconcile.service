[Unit]
Description=Reconcile Nexigon application configuration
After=network-online.target nexigon-agent.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=NEXIGON_RUGIX_APPS_USE_BUNDLE_HASH=@@USE_BUNDLE_HASH@@
StateDirectory=nexigon/rugix-apps
ExecStart=/usr/libexec/nexigon/nexigon-rugix-apps-reconcile
